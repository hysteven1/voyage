# Local Docker Compose only. Never overwrite an existing .env.
# Choose before first DB initialization; keep the existing value for existing data.
# Required. There is no built-in password fallback. Use a unique URL-safe value.
POSTGRES_PASSWORD=
POSTGRES_USER=voyage
POSTGRES_DB=voyage
# Expanded UI planning requires your own paid API key; leave empty for no-key smoke tests.
OPENAI_API_KEY=
SERPAPI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-6.1-sol
OPENAI_RECOVERY_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
